 "beats": [
  {
   "scene": "behind",
   "text": "Eu moro atrás da *geladeira*."
  },
  {
   "scene": "behind",
   "text": "E aqui é *quente*."
  },
  {
   "scene": "behind",
   "text": "Esse calor saiu lá de *dentro*."
  },
  {
   "scene": "heatmove",
   "text": "A geladeira não *cria* frio."
  },
  {
   "scene": "heatmove",
   "text": "Ela *tira* calor de dentro e joga aqui fora, em mim."
  },
  {
   "scene": "pipes",
   "text": "Quem faz isso é um fluido que corre pelos canos: o *gás refrigerante*."
  },
  {
   "scene": "evap",
   "text": "Lá dentro, ele passa por canos com *pressão baixa* e *evapora*."
  },
  {
   "scene": "sweat",
   "text": "E evaporar *rouba* calor, igual o *suor* secando na sua pele."
  },
  {
   "scene": "sweat",
   "text": "Por isso tudo lá dentro *esfria*."
  },
  {
   "scene": "vision",
   "text": "Aí ele chega no motor, aqui embaixo: o *compressor*."
  },
  {
   "scene": "vision",
   "text": "Esse *zumbido* que eu escuto o dia todo."
  },
  {
   "scene": "compress",
   "text": "Ele *espreme* o gás e deixa ele quente, bem *quente*."
  },
  {
   "scene": "condenser",
   "text": "Esse gás quente passa pela *grade* atrás da geladeira, solta o calor no ar e vira *líquido* de novo."
  },
  {
   "scene": "condenser",
   "text": "E o ciclo *recomeça*."
  },
  {
   "scene": "icecream",
   "text": "Ou seja: cada sorvete gelado que você tira lá de dentro…"
  },
  {
   "scene": "icecream",
   "text": "*esquentou* a minha casa.",
   "pause_before": 0.3,
   "payoff": true
  }
 ],

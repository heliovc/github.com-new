# copie para /etc/canal-publisher.env
REPO_DIR=/opt/canal-publisher/repo
PROFILE_DIR=/opt/canal-publisher/profile
STATE_DIR=/opt/canal-publisher/state
LOG_DIR=/opt/canal-publisher/logs
# minutos de espera depois que a rotina sobe o episódio (dá tempo de ela publicar pelo Chrome do Mac).
# Quando o Mac sair de vez do fluxo, mude para 0.
GRACE_MINUTES=90
# notificação no celular (opcional): app ntfy + tópico secreto, ex. https://ntfy.sh/canal-dark-<algo-aleatorio>
NOTIFY_URL=
GIT_PUSH=1
TZ=America/Sao_Paulo
